<?xml version="1.0" encoding="utf-8"?>
<!-- App backdrop (dark): ink base with soft blue / violet light orbs.
     The orbs are what the frosted glass panels sit on top of. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#050506" />
        </shape>
    </item>
    <item
        android:width="620dp"
        android:height="620dp"
        android:gravity="top|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="310dp"
                android:startColor="#2EFFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item
        android:width="560dp"
        android:height="560dp"
        android:gravity="bottom|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:startColor="#24B4B8C4"
                android:centerColor="#0CB4B8C4"
                android:endColor="#00B4B8C4" />
        </shape>
    </item>
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
