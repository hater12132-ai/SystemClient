<?xml version="1.0" encoding="utf-8"?>
<!-- App backdrop (dark): ink base with soft blue / violet light orbs.
     The orbs are what the frosted glass panels sit on top of. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080A12" />
        </shape>
    </item>
    <item
        android:width="620dp"
        android:height="620dp"
        android:gravity="top|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="310dp"
                android:startColor="#552F6BFF"
                android:centerColor="#222F6BFF"
                android:endColor="#002F6BFF" />
        </shape>
    </item>
    <item
        android:width="560dp"
        android:height="560dp"
        android:gravity="bottom|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:startColor="#476B4DFF"
                android:centerColor="#1C6B4DFF"
                android:endColor="#006B4DFF" />
        </shape>
    </item>
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#2A18B6E6"
                android:endColor="#0018B6E6" />
        </shape>
    </item>
</layer-list>
