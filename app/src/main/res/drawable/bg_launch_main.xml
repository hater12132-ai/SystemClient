<?xml version="1.0" encoding="utf-8"?>
<!-- Static fallback for the LAUNCH button. At runtime MainActivity swaps in LiquidGlassDrawable
     (same black glass, plus rim light and specular highlight). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#E6000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
